    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <!-- H2: a free database written in Java. One jar, no install. Used from lesson 25 (examples find this version too: see scripts/run-examples.sh). -->
    <h2.version>2.4.240</h2.version>
    <!-- Spring Boot (lesson 36 on). Its BOM below fixes the version of Spring, Jackson (lesson 35), Hibernate, Flyway ... so
         that they fit each other: a lesson's pom names a library and never its version. 3.5.x is the last 3.x line, for Java 17+. -->
    <spring-boot.version>3.5.16</spring-boot.version>
    <!-- springdoc (lesson 44): builds the OpenAPI description of the API from the controllers. The 2.8.x line is the one made for Spring Boot 3.5
         (springdoc 3.x needs Spring Boot 4). Checked: it exists on Maven Central. -->
    <springdoc.version>2.8.17</springdoc.version>
  </properties>

