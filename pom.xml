<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.javabybuilding</groupId>
  <artifactId>java-by-building</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>Java by Building</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
  </properties>

  <!-- Default build = the reference solutions (these must always pass). -->
  <modules>
    <module>lessons/01-hello-java/solution</module>
    <module>lessons/02-variables-and-money/solution</module>
    <module>lessons/03-decisions-and-loops/solution</module>
    <module>lessons/04-methods-and-arrays/solution</module>
    <module>lessons/05-strings-and-text/solution</module>
    <module>lessons/06-scanner-and-input/solution</module>
    <module>lessons/07-arraylist-and-hashmap/solution</module>
    <module>lessons/08-console-menu/solution</module>
    <module>lessons/09-classes-and-objects/solution</module>
    <module>lessons/10-encapsulation/solution</module>
    <module>lessons/11-product-and-customer/solution</module>
    <module>lessons/12-static-vs-instance/solution</module>
    <module>lessons/13-inheritance/solution</module>
    <module>lessons/14-interfaces-and-polymorphism/solution</module>
    <module>lessons/15-enums-and-records/solution</module>
    <module>lessons/16-exceptions/solution</module>
  </modules>

  <profiles>
    <!-- Student code (starters + exercises) is expected to FAIL tests until completed,
         so CI only checks that it compiles: mvn -Pstudent test-compile -->
    <profile>
      <id>student</id>
      <modules>
        <module>lessons/01-hello-java/starter</module>
        <module>lessons/01-hello-java/exercises</module>
        <module>lessons/02-variables-and-money/starter</module>
        <module>lessons/02-variables-and-money/exercises</module>
        <module>lessons/03-decisions-and-loops/starter</module>
        <module>lessons/03-decisions-and-loops/exercises</module>
        <module>lessons/04-methods-and-arrays/starter</module>
        <module>lessons/04-methods-and-arrays/exercises</module>
        <module>lessons/05-strings-and-text/starter</module>
        <module>lessons/05-strings-and-text/exercises</module>
        <module>lessons/06-scanner-and-input/starter</module>
        <module>lessons/06-scanner-and-input/exercises</module>
        <module>lessons/07-arraylist-and-hashmap/starter</module>
        <module>lessons/07-arraylist-and-hashmap/exercises</module>
        <module>lessons/08-console-menu/starter</module>
        <module>lessons/08-console-menu/exercises</module>
        <module>lessons/09-classes-and-objects/starter</module>
        <module>lessons/09-classes-and-objects/exercises</module>
        <module>lessons/10-encapsulation/starter</module>
        <module>lessons/10-encapsulation/exercises</module>
        <module>lessons/11-product-and-customer/starter</module>
        <module>lessons/11-product-and-customer/exercises</module>
        <module>lessons/12-static-vs-instance/starter</module>
        <module>lessons/12-static-vs-instance/exercises</module>
        <module>lessons/13-inheritance/starter</module>
        <module>lessons/13-inheritance/exercises</module>
        <module>lessons/14-interfaces-and-polymorphism/starter</module>
        <module>lessons/14-interfaces-and-polymorphism/exercises</module>
        <module>lessons/15-enums-and-records/starter</module>
        <module>lessons/15-enums-and-records/exercises</module>
        <module>lessons/16-exceptions/starter</module>
        <module>lessons/16-exceptions/exercises</module>
      </modules>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
