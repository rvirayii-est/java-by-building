<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.javabybuilding</groupId>
    <artifactId>java-by-building</artifactId>
    <version>0.1.0</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>
  <artifactId>l37-starter</artifactId>
  <name>Lesson 37 (starter)</name>

  <properties>
    <!-- Keep the names of method parameters in the .class files: Spring needs them to match /products/{name} to a parameter
         called name. (The Spring Boot parent pom sets this for you; this course has its own parent, so it is set here.) -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
  </properties>

  <dependencies>
    <!-- The H2 database: needed by the app from lesson 25 on (SQL practice now, JDBC later). -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
    </dependency>
    <!-- Spring Boot's "web starter" (lesson 36): ONE dependency that brings Spring MVC, the Tomcat web server, Jackson and
         logging, all in versions that fit each other. The version comes from the BOM in the root pom. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Everything needed to test a Spring Boot app: JUnit 5, AssertJ, Mockito, Spring's test support, MockMvc (lesson 40). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>shop-api</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Mockito (inside spring-boot-starter-test) loads a small Java agent while the tests run. Java 21 prints a warning for that
               unless it is allowed on purpose. -->
          <argLine>-XX:+EnableDynamicAgentLoading</argLine>
          <!-- Keep the test output quiet: java.util.logging reads this file instead of printing every INFO line to the console. -->
          <systemPropertyVariables>
            <java.util.logging.config.file>${project.basedir}/src/test/resources/logging.properties</java.util.logging.config.file>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- Adds "spring-boot:run" and, with the repackage goal, builds ONE runnable jar that holds the app and every library:
           java -jar target/shop-api.jar (the Spring Boot parent pom does the second part for you; this course has its own parent). -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
