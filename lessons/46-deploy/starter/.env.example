# Copy this file to ".env" (same folder), then put YOUR OWN values. ".env" is private: never commit it, never paste it in a chat.
# Passwords: 12 characters or more. The app refuses to start with anything shorter, or with a value that still starts with "change-me".
SHOP_ADMIN_PASSWORD=change-me-admin-password
SHOP_CASHIER_PASSWORD=change-me-cashier-password

# Optional settings (the defaults are in application-prod.properties). Remove the # to use one.
# SHOP_SEED_SAMPLE=true          # fill an EMPTY database with the four sample products (a demo); false for a real shop
# SHOP_SWAGGER_ENABLED=true      # show the Swagger page (the API description at /v3/api-docs stays available)
# PORT=8080                      # the port inside the container; many hosting services set this one for you
